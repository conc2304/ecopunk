# Standalone test build for the video-playback subsystem's pure-logic
# pieces (MediaCatalog::build(), VideoSelectionPolicy) -- deliberately
# independent of any sketch's own openFrameworks Makefile/build, same
# rationale as sketches/blob-region-prototype/test/Makefile.tests and
# sketches/experience_runtime/test/Makefile.tests: MediaCatalog.{h,cpp},
# MediaMetadata.h, VideoPlaybackStatus.h, and VideoSelectionPolicy.{h,cpp}
# were specifically kept free of any openFrameworks include (confirmed by
# probe: even ofRectangle.h alone pulls in ofConstants.h -> GL/glew.h, and
# this subsystem's own OF-dependent pieces -- IVideoDecoder.h,
# OfVideoDecoder.{h,cpp}, VideoPlaybackService.{h,cpp},
# MediaCatalogJsonLoader.cpp -- are excluded from this build on purpose),
# so this compiles and links with nothing but a bare compiler.
#
# IMPORTANT -- do not delete this test/ directory or rename it to
# something other than "test": every sketch whose config.make pulls in all
# of ../../shared/src (not a scoped subset -- see
# sketches/experience_runtime/config.make for the scoped alternative) must
# add an exclusion for this exact directory, e.g.:
#   PROJECT_EXCLUSIONS = ../../shared/src/video-playback/test%
# otherwise this directory's *_tests.cpp files (each define their own
# main()) get swept into that sketch's own build by
# PROJECT_EXTERNAL_SOURCE_PATHS' recursive directory scan and collide with
# the sketch's real main.cpp at link time. See this increment's
# implementation report, "Newly discovered risks", for a pre-existing
# instance of this same hazard already latent in
# shared/src/video-effects/test/.
#
# Usage (from this directory):
#   make -f Makefile.tests test

CXX ?= c++
CXXFLAGS = -std=c++17 -Wall -Wextra

CATALOG_SRC = media_catalog_tests.cpp ../MediaCatalog.cpp
CATALOG_BIN = media_catalog_tests

POLICY_SRC = video_selection_policy_tests.cpp ../VideoSelectionPolicy.cpp
POLICY_BIN = video_selection_policy_tests

# Dwell / long-clip resume-window policy (same pure VideoSelectionPolicy).
RESUME_SRC = video_resume_window_tests.cpp ../VideoSelectionPolicy.cpp
RESUME_BIN = video_resume_window_tests

# Runtime cadence switch (automatic vs boundary-driven next()).
ADVANCE_SRC = video_advance_mode_tests.cpp ../VideoSelectionPolicy.cpp
ADVANCE_BIN = video_advance_mode_tests

# -- test-activation: VideoPlaybackService::activationCount() (OC-003B). The real
# service with a fake IVideoDecoder; OF-linked (ofDirectory/ofLog) but no window
# or GL context. Not part of `test` (which stays compiler-only); run on its own.
OF_ROOT_REAL ?= $(or $(OF_ROOT),/Users/joseconchello/openFrameworks)
ACT_OF_INCLUDES = $(addprefix -I$(OF_ROOT_REAL)/libs/,FreeImage/include cairo/include cairo/include/cairo curl/include \
	fmt/include fmt/include/fmt freetype/include freetype/include/freetype glew/include glew/include/GL glfw/include \
	glfw/include/GLFW glm/include json/include libpng/include openssl/include pixman/include pugixml/include \
	rtAudio/include tess2/include uriparser/include utf8/include zlib/include openFrameworks openFrameworks/3d \
	openFrameworks/video openFrameworks/types openFrameworks/app openFrameworks/utils openFrameworks/math \
	openFrameworks/gl openFrameworks/communication openFrameworks/events openFrameworks/graphics openFrameworks/sound)
ACT_LIBS = $(OF_ROOT_REAL)/libs/openFrameworksCompiled/lib/osx/libopenFrameworks.a \
	$(wildcard $(OF_ROOT_REAL)/libs/*/lib/macos/*.xcframework/macos-arm64_x86_64/*.a)
ACT_FRAMEWORKS = -framework Accelerate -framework AppKit -framework ApplicationServices -framework AVFoundation \
	-framework AudioToolbox -framework Cocoa -framework CoreVideo -framework CoreAudio -framework CoreMedia \
	-framework CoreFoundation -framework CoreServices -framework Metal -framework Foundation -framework IOKit \
	-framework OpenGL -framework QuartzCore -framework Security -framework SystemConfiguration
ACT_SRC = video_activation_count_tests.cpp ../VideoPlaybackService.cpp ../OfVideoDecoder.cpp ../MediaCatalog.cpp \
	../MediaCatalogJsonLoader.cpp ../VideoSelectionPolicy.cpp
ACT_BIN = video_activation_count_tests

# -- test-startup-media: OC-003 verification control (deterministic startup media, rejection, unchanged default). Same
# OF-linked fake-decoder harness as test-activation; not part of `test`.
STM_SRC = video_startup_media_tests.cpp ../VideoPlaybackService.cpp ../OfVideoDecoder.cpp ../MediaCatalog.cpp \
	../MediaCatalogJsonLoader.cpp ../VideoSelectionPolicy.cpp
STM_BIN = video_startup_media_tests

.PHONY: test test-activation test-startup-media clean

test-activation: $(ACT_BIN)
	./$(ACT_BIN)

$(ACT_BIN): $(ACT_SRC) ../VideoPlaybackService.h
	c++ -std=c++17 -stdlib=libc++ -DUSE_FMOD=0 -D__MACOSX_CORE__ -Wall -x objective-c++ $(ACT_OF_INCLUDES) -I.. -I../.. \
		$(ACT_SRC) -x none -mmacosx-version-min=10.15 $(ACT_FRAMEWORKS) $(ACT_LIBS) -lobjc -o $@


test-startup-media: $(STM_BIN)
	./$(STM_BIN)

$(STM_BIN): $(STM_SRC) ../VideoPlaybackService.h ../VideoSelectionPolicy.h
	c++ -std=c++17 -stdlib=libc++ -DUSE_FMOD=0 -D__MACOSX_CORE__ -Wall -x objective-c++ $(ACT_OF_INCLUDES) -I.. -I../.. \
		$(STM_SRC) -x none -mmacosx-version-min=10.15 $(ACT_FRAMEWORKS) $(ACT_LIBS) -lobjc -o $@

test: $(CATALOG_BIN) $(POLICY_BIN) $(RESUME_BIN) $(ADVANCE_BIN)
	./$(CATALOG_BIN)
	./$(POLICY_BIN)
	./$(RESUME_BIN)
	./$(ADVANCE_BIN)

$(CATALOG_BIN): $(CATALOG_SRC) ../MediaCatalog.h ../MediaMetadata.h
	$(CXX) $(CXXFLAGS) $(CATALOG_SRC) -o $(CATALOG_BIN)

$(POLICY_BIN): $(POLICY_SRC) ../VideoSelectionPolicy.h ../MediaMetadata.h ../VideoPlaybackStatus.h
	$(CXX) $(CXXFLAGS) $(POLICY_SRC) -o $(POLICY_BIN)

$(RESUME_BIN): $(RESUME_SRC) ../VideoSelectionPolicy.h ../MediaMetadata.h ../VideoPlaybackStatus.h
	$(CXX) $(CXXFLAGS) $(RESUME_SRC) -o $(RESUME_BIN)

$(ADVANCE_BIN): $(ADVANCE_SRC) ../VideoSelectionPolicy.h ../MediaMetadata.h ../VideoPlaybackStatus.h
	$(CXX) $(CXXFLAGS) $(ADVANCE_SRC) -o $(ADVANCE_BIN)

clean:
	rm -f $(CATALOG_BIN) $(POLICY_BIN) $(RESUME_BIN) $(ADVANCE_BIN)

{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(*)"
    ],
    "ask": [
      "Bash(npm install*)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(yarn install*)"
    ]
  }
}
# Standalone test build for FakeSceneLifecycleState and (Engineering
# Session 2) the real VideoPlaybackStatus/EffectActivityStatus integration
# surface -- deliberately independent of the sketch's own openFrameworks
# Makefile/build, same rationale as
# sketches/blob-region-prototype/test/Makefile.tests and
# sketches/temporal-fields/test/Makefile.tests: FakeSceneLifecycleState.h,
# shared/src/video-playback/VideoPlaybackStatus.h, and
# shared/src/video-effects/knowledge/EffectActivityStatus.h are all
# specifically kept free of any openFrameworks include (confirmed by
# probe: even ofRectangle.h alone pulls in ofConstants.h -> GL/glew.h, and
# SceneContract.h's SceneFrame member pulls in ofTexture.h the same way),
# so both binaries below compile and link with nothing but a bare compiler.
#
# Lives in test/ (a sibling of src/, not nested inside it) -- this
# sketch's own Makefile recursively sweeps every .cpp under src/ into the
# app build, so a src/test/*.cpp here would collide with its main() at
# link time (see tf_timeline_tests.cpp's header comment for where this was
# first hit in this repo).
#
# Usage (from this sketch's root,
# apps/myApps/EcopunkVideoCollage/sketches/experience_runtime/):
#   make -C test -f Makefile.tests test

CXX ?= c++
CXXFLAGS = -std=c++17 -Wall -Wextra

# EffectActivityStatus.h's own comment: resolved via this monorepo's flat
# per-subdirectory include path (same pattern used inside shared/src/
# video-effects/ itself) -- these three -I's mirror
# ../config.make's PROJECT_CFLAGS additions for the real sketch build.
#
# The glm -I is a genuinely unavoidable transitive dependency, not a
# compromise of the "bare compiler, no OF/GL" convention this test
# directory otherwise follows: VideoEffectTypes.h uses glm::vec2 for pure
# value math, and glm itself has zero GL/window/OF dependency (it's a
# header-only math library OF happens to bundle, not part of OF itself) --
# confirmed by trying the build without it first, which fails on exactly
# and only this one header, nothing GL-shaped.
SESSION2_CXXFLAGS = $(CXXFLAGS) \
	-I../../../shared/src/video-effects/core \
	-I../../../shared/src/video-effects/evolution \
	-I../../../shared/src/video-effects/knowledge \
	-I../../../../../../libs/glm/include

LIFECYCLE_SRC = lifecycle_state_tests.cpp
LIFECYCLE_BIN = lifecycle_state_tests

# EffectActivityStatus.cpp itself is the only real-shared-effects
# translation unit these tests need linked in -- see
# ../config.make's PROJECT_CFLAGS comment for why (this .cpp doesn't call
# into EffectEvolutionController/EffectKnowledgeBase/EffectRandomizer/
# VideoEffectDefinition's own .cpp files, only uses EvolutionPhase as a
# value type). VideoPlaybackStatus.h is header-only (plain structs/enums,
# no .cpp).
SESSION2_SRC = session2_integration_tests.cpp ../../../shared/src/video-effects/knowledge/EffectActivityStatus.cpp
SESSION2_BIN = session2_integration_tests

# Blob First Production Acceptance narrow patch: blobsemantics::compute()
# (../src/BlobSemanticMapping.h/.cpp) only needs SceneSemanticTypes.h, which
# is itself OF-free (confirmed: only <cstdint>/<optional>/<string>/<vector>)
# — no glm/-I needed beyond locating that one header, same bare-compiler
# convention as LIFECYCLE_BIN/SESSION2_BIN above.
BLOB_SEMANTIC_CXXFLAGS = $(CXXFLAGS) -I../../../shared/src/scene
BLOB_SEMANTIC_SRC = blob_semantic_mapping_tests.cpp ../src/BlobSemanticMapping.cpp
BLOB_SEMANTIC_BIN = blob_semantic_mapping_tests

# Blob curated fragment-effect policy (../src/BlobEffectPolicy.h/.cpp) —
# OF-free, standard library only.
BLOB_EFFECT_POLICY_SRC = blob_effect_policy_tests.cpp ../src/BlobEffectPolicy.cpp
BLOB_EFFECT_POLICY_BIN = blob_effect_policy_tests

# Blob Experiment 2 capacity plan (../src/BlobCapacityPlan.h/.cpp) — OF-free.
BLOB_CAPACITY_PLAN_SRC = blob_capacity_plan_tests.cpp ../src/BlobCapacityPlan.cpp
BLOB_CAPACITY_PLAN_BIN = blob_capacity_plan_tests

# Blob production effect budget (../src/BlobEffectBudget.h/.cpp) — OF-free.
BLOB_EFFECT_BUDGET_SRC = blob_effect_budget_tests.cpp ../src/BlobEffectBudget.cpp
BLOB_EFFECT_BUDGET_BIN = blob_effect_budget_tests

# Per-video Blob detection presets (../../../shared/src/BlobDetectionProfileStore.h/.cpp).
# OF-free; needs only the header-only nlohmann/json bundled with openFrameworks.
BLOB_DETECTION_PROFILE_CXXFLAGS = $(CXXFLAGS) -I../../../shared/src -I../../../../../../libs/json/include
BLOB_DETECTION_PROFILE_SRC = blob_detection_profile_tests.cpp ../../../shared/src/BlobDetectionProfileStore.cpp
BLOB_DETECTION_PROFILE_BIN = blob_detection_profile_tests

# Temporal Production Scene #2 Migration: temporalsemantics::compute()
# (../src/TemporalSemanticMapping.h/.cpp) has the exact same OF-free
# dependency shape as blobsemantics::compute() above (only
# SceneSemanticTypes.h) — same bare-compiler convention, no new -I beyond
# locating that one header.
TEMPORAL_SEMANTIC_CXXFLAGS = $(CXXFLAGS) -I../../../shared/src/scene
TEMPORAL_SEMANTIC_SRC = temporal_semantic_mapping_tests.cpp ../src/TemporalSemanticMapping.cpp
TEMPORAL_SEMANTIC_BIN = temporal_semantic_mapping_tests

# BLUE-001: blueprintsemantics::compute() — same OF-free shape as above.
BLUEPRINT_SEMANTIC_CXXFLAGS = $(CXXFLAGS) -I../../../shared/src/scene
BLUEPRINT_SEMANTIC_SRC = blueprint_semantic_mapping_tests.cpp ../src/BlueprintSemanticMapping.cpp
BLUEPRINT_SEMANTIC_BIN = blueprint_semantic_mapping_tests

# Quadrant Crosshair: quadrantsemantics::compute() — same OF-free shape as above.
QUADRANT_SEMANTIC_CXXFLAGS = $(CXXFLAGS) -I../../../shared/src/scene
QUADRANT_SEMANTIC_SRC = quadrant_semantic_mapping_tests.cpp ../src/QuadrantSemanticMapping.cpp
QUADRANT_SEMANTIC_BIN = quadrant_semantic_mapping_tests

# RT-006: fragmentsemantics::compute() — same OF-free shape as above.
FRAGMENT_SEMANTIC_CXXFLAGS = $(CXXFLAGS) -I../../../shared/src/scene
FRAGMENT_SEMANTIC_SRC = fragment_semantic_mapping_tests.cpp ../src/FragmentSemanticMapping.cpp
FRAGMENT_SEMANTIC_BIN = fragment_semantic_mapping_tests

# RT-003: sceneswitch::Controller (../src/SceneSwitchController.h) is the
# header-only, OF-free production state machine behind SceneManager's
# Blob <-> Temporal switching — same bare-compiler convention as
# LIFECYCLE_BIN above (no -I needed, no .cpp to link).
SCENE_SWITCH_SRC = scene_switch_controller_tests.cpp
SCENE_SWITCH_BIN = scene_switch_controller_tests

# HUD-004 first shell-only loader: HudSkinPng + HudSkinLoader (OF-free) linked
# against the ACCEPTED validator in tools/hud-skin-manifest/ (the same .cpp the
# app build reaches through its src/ symlink) and nlohmann/json.hpp, which
# openFrameworks ships header-only in libs/json/include — no OF/GL linkage.
SKIN_LOADER_CXXFLAGS = $(CXXFLAGS) \
	-I../../../tools/hud-skin-manifest \
	-I../../../shared/src/hud-compositor \
	-I../../../../../../libs/json/include \
	-DHUD_SKIN_TEST_FIXTURE_DIR='"$(abspath skin_fixtures)"'
SKIN_LOADER_SRC = hud_skin_loader_tests.cpp ../src/HudSkinLoader.cpp ../src/HudSkinPng.cpp \
	../../../tools/hud-skin-manifest/HudSkinManifest.cpp
SKIN_LOADER_BIN = hud_skin_loader_tests

# Playable HUD Menu v0.1: HudFocusNavigator (OF-free, no -I needed).
FOCUS_SRC = hud_focus_navigator_tests.cpp ../src/HudFocusNavigator.cpp
FOCUS_BIN = hud_focus_navigator_tests

# HUD Clock v0.1: WallClockSampler (OF-free, header-only) end to end through
# the HUD's pure HudClockFormat.h. Uses real OS zoneinfo via explicit TZ.
WALL_CLOCK_CXXFLAGS = $(CXXFLAGS) -I../../../shared/src/hud-runtime -I../../../shared/src/hud-compositor
WALL_CLOCK_SRC = wall_clock_sampler_tests.cpp
WALL_CLOCK_BIN = wall_clock_sampler_tests

# Orbit Console Scene Sampling v0.1: SceneColorSeries.h (OF-free, header-only).
SCENE_COLOR_SRC = scene_color_series_tests.cpp
SCENE_COLOR_BIN = scene_color_series_tests

# A7 deferred-readback gate (SceneColorDeferredGate.h, OF-free, header-only).
SCENE_COLOR_GATE_SRC = scene_color_deferred_gate_tests.cpp
SCENE_COLOR_GATE_BIN = scene_color_deferred_gate_tests

# OC-004 visual-activity tracker/publisher (../src/SceneVisualActivityTracker.h) - OF-free.
VISUAL_ACTIVITY_SRC = visual_activity_tracker_tests.cpp
VISUAL_ACTIVITY_BIN = visual_activity_tracker_tests

# OC-004 precomputed clip activity: curve lookup + per-frame feeder (../src/ClipActivity.h) - OF-free.
CLIP_ACTIVITY_SRC = clip_activity_tests.cpp
CLIP_ACTIVITY_BIN = clip_activity_tests

# OC-003B RAW VIDEO gate / format validation / flag (RawVideoGate.h, OF-free, header-only).
RAW_VIDEO_SRC = raw_video_gate_tests.cpp
RAW_VIDEO_BIN = raw_video_gate_tests

# System Telemetry v1 (../src/SystemVitals.h/.cpp) — OF-free, standard library only.
SYSTEM_VITALS_SRC = system_vitals_tests.cpp ../src/SystemVitals.cpp
SYSTEM_VITALS_BIN = system_vitals_tests

# Installation Controls & ENERGY v0.1: installation::Controller (OF-free, header-only).
INSTALLATION_SRC = installation_control_tests.cpp
INSTALLATION_BIN = installation_control_tests
# Experience Settings page v0.1: page model + SystemClockService (OF-free).
SETTINGS_PAGE_SRC = experience_settings_page_tests.cpp ../src/SystemClockService.cpp ../src/HudFocusNavigator.cpp
SETTINGS_PAGE_BIN = experience_settings_page_tests
SCHEDULE_SRC = hud_skin_schedule_tests.cpp
SCHEDULE_BIN = hud_skin_schedule_tests
PRESENTATION_SRC = presentation_transform_tests.cpp
PRESENTATION_BIN = presentation_transform_tests

.PHONY: test oc003f visual-activity clip-activity raw-video session2 skin focus wall-clock installation clean

focus: $(FOCUS_BIN)
	./$(FOCUS_BIN)

wall-clock: $(WALL_CLOCK_BIN)
	./$(WALL_CLOCK_BIN)

installation: $(INSTALLATION_BIN)
	./$(INSTALLATION_BIN)

settings-page: $(SETTINGS_PAGE_BIN)
	./$(SETTINGS_PAGE_BIN)

presentation: $(PRESENTATION_BIN)
	./$(PRESENTATION_BIN)

schedule: $(SCHEDULE_BIN)
	./$(SCHEDULE_BIN)

$(SCHEDULE_BIN): $(SCHEDULE_SRC) ../src/HudSkinSchedule.h
	$(CXX) $(CXXFLAGS) -I../src $(SCHEDULE_SRC) -o $(SCHEDULE_BIN)

$(PRESENTATION_BIN): $(PRESENTATION_SRC) ../src/PresentationTransform.h
	$(CXX) $(CXXFLAGS) -I../src $(PRESENTATION_SRC) -o $(PRESENTATION_BIN)

$(INSTALLATION_BIN): $(INSTALLATION_SRC) ../src/InstallationControl.h
	$(CXX) $(CXXFLAGS) -I../src -pthread $(INSTALLATION_SRC) -o $(INSTALLATION_BIN)

$(SETTINGS_PAGE_BIN): $(SETTINGS_PAGE_SRC) ../src/ExperienceSettingsPage.h ../src/SystemClockService.h ../src/InstallationControl.h ../src/DpadInput.h
	$(CXX) $(CXXFLAGS) -I../src -pthread $(SETTINGS_PAGE_SRC) -o $(SETTINGS_PAGE_BIN)

$(SYSTEM_VITALS_BIN): $(SYSTEM_VITALS_SRC) ../src/SystemVitals.h
	$(CXX) $(CXXFLAGS) -I../src -I../../../shared/src/hud-runtime $(SYSTEM_VITALS_SRC) -o $(SYSTEM_VITALS_BIN)

$(WALL_CLOCK_BIN): $(WALL_CLOCK_SRC) ../../../shared/src/hud-runtime/WallClockSampler.h ../../../shared/src/hud-runtime/WallClockStatus.h ../../../shared/src/hud-compositor/HudClockFormat.h
	$(CXX) $(WALL_CLOCK_CXXFLAGS) $(WALL_CLOCK_SRC) -o $(WALL_CLOCK_BIN)

$(FOCUS_BIN): $(FOCUS_SRC) ../src/HudFocusNavigator.h ../src/HudRegionInteraction.h ../src/SceneFxModel.h ../src/RawRevealController.h ../../../shared/src/hud-compositor/HudFocusEmphasis.h
	$(CXX) $(CXXFLAGS) $(FOCUS_SRC) -o $(FOCUS_BIN)


# OC-003-F diagnostic CPU RAW acquisition / palette analyzer / palette sink (all OF-free, header-only).
OC003F_CXXFLAGS = $(CXXFLAGS) -I../src -I../../../shared/src/hud-runtime
CPU_RAW_BIN = cpu_raw_acquisition_tests
PALETTE_BIN = palette_analyzer_tests
PALETTE_SINK_BIN = palette_sink_tests
PREDOMINANT_BIN = predominant_color_tests

PALETTE_REPLAY_BIN = palette_replay

oc003f: $(CPU_RAW_BIN) $(PALETTE_BIN) $(PALETTE_SINK_BIN) $(PALETTE_REPLAY_BIN)
	./$(CPU_RAW_BIN)
	./$(PALETTE_BIN)
	./$(PALETTE_SINK_BIN)

$(CPU_RAW_BIN): cpu_raw_acquisition_tests.cpp ../src/CpuRawAcquisition.h ../src/RawVideoGate.h ../src/SceneColorSeries.h ../src/PredominantColor.h
	$(CXX) $(OC003F_CXXFLAGS) cpu_raw_acquisition_tests.cpp -o $(CPU_RAW_BIN)

$(PALETTE_BIN): palette_analyzer_tests.cpp ../src/PaletteAnalyzer.h
	$(CXX) $(OC003F_CXXFLAGS) palette_analyzer_tests.cpp -o $(PALETTE_BIN)

palette_fixture_gen: palette_fixture_gen.cpp ../src/PaletteSink.h ../src/PaletteAnalyzer.h
	$(CXX) $(OC003F_CXXFLAGS) palette_fixture_gen.cpp -o palette_fixture_gen

$(PALETTE_REPLAY_BIN): palette_replay.cpp ../src/PaletteAnalyzer.h
	$(CXX) $(OC003F_CXXFLAGS) palette_replay.cpp -o $(PALETTE_REPLAY_BIN)

$(PALETTE_SINK_BIN): palette_sink_tests.cpp ../src/PaletteSink.h ../src/PaletteAnalyzer.h ../src/SceneColorSeries.h
	$(CXX) $(OC003F_CXXFLAGS) palette_sink_tests.cpp -o $(PALETTE_SINK_BIN)

raw-video: $(RAW_VIDEO_BIN)
	./$(RAW_VIDEO_BIN)

$(RAW_VIDEO_BIN): $(RAW_VIDEO_SRC) ../src/RawVideoGate.h ../src/SceneColorSeries.h
	$(CXX) $(CXXFLAGS) -I../src -I../../../shared/src/hud-runtime $(RAW_VIDEO_SRC) -o $(RAW_VIDEO_BIN)

scene-color: $(SCENE_COLOR_BIN)
	./$(SCENE_COLOR_BIN)

$(SCENE_COLOR_BIN): $(SCENE_COLOR_SRC) ../src/SceneColorSeries.h ../../../shared/src/hud-runtime/SceneColorSnapshot.h
	$(CXX) $(CXXFLAGS) -I../src -I../../../shared/src/hud-runtime $(SCENE_COLOR_SRC) -o $(SCENE_COLOR_BIN)

scene-color-gate: $(SCENE_COLOR_GATE_BIN)
	./$(SCENE_COLOR_GATE_BIN)

$(SCENE_COLOR_GATE_BIN): $(SCENE_COLOR_GATE_SRC) ../src/SceneColorDeferredGate.h ../src/SceneColorSeries.h ../../../shared/src/hud-runtime/SceneColorSnapshot.h
	$(CXX) $(CXXFLAGS) -I../src -I../../../shared/src/hud-runtime $(SCENE_COLOR_GATE_SRC) -o $(SCENE_COLOR_GATE_BIN)

visual-activity: $(VISUAL_ACTIVITY_BIN)
	./$(VISUAL_ACTIVITY_BIN)

$(VISUAL_ACTIVITY_BIN): $(VISUAL_ACTIVITY_SRC) ../src/SceneVisualActivityTracker.h ../src/SceneActivityCore.h ../../../shared/src/hud-runtime/SceneVisualActivitySnapshot.h
	$(CXX) $(CXXFLAGS) -I../src -I../../../shared/src/hud-runtime $(VISUAL_ACTIVITY_SRC) -o $(VISUAL_ACTIVITY_BIN)

clip-activity: $(CLIP_ACTIVITY_BIN)
	./$(CLIP_ACTIVITY_BIN)

$(CLIP_ACTIVITY_BIN): $(CLIP_ACTIVITY_SRC) ../src/ClipActivity.h ../src/SceneVisualActivityTracker.h ../src/SceneActivityCore.h ../../../shared/src/hud-runtime/SceneVisualActivitySnapshot.h
	$(CXX) $(CXXFLAGS) -I../src -I../../../shared/src/hud-runtime $(CLIP_ACTIVITY_SRC) -o $(CLIP_ACTIVITY_BIN)

test: $(LIFECYCLE_BIN) $(SESSION2_BIN) $(BLOB_SEMANTIC_BIN) $(BLOB_EFFECT_POLICY_BIN) $(BLOB_CAPACITY_PLAN_BIN) $(BLOB_EFFECT_BUDGET_BIN) $(BLOB_DETECTION_PROFILE_BIN) $(TEMPORAL_SEMANTIC_BIN) $(BLUEPRINT_SEMANTIC_BIN) $(FRAGMENT_SEMANTIC_BIN) $(QUADRANT_SEMANTIC_BIN) $(SCENE_SWITCH_BIN) $(SKIN_LOADER_BIN) $(FOCUS_BIN) $(WALL_CLOCK_BIN) $(SYSTEM_VITALS_BIN) $(INSTALLATION_BIN) $(SETTINGS_PAGE_BIN) $(PRESENTATION_BIN) $(SCHEDULE_BIN) $(SCENE_COLOR_BIN) $(SCENE_COLOR_GATE_BIN) $(VISUAL_ACTIVITY_BIN) $(CLIP_ACTIVITY_BIN)
	./$(SCENE_COLOR_BIN)
	./$(SCENE_COLOR_GATE_BIN)
	./$(VISUAL_ACTIVITY_BIN)
	./$(CLIP_ACTIVITY_BIN)
	./$(SESSION2_BIN)
	./$(BLOB_SEMANTIC_BIN)
	./$(BLOB_EFFECT_POLICY_BIN)
	./$(BLOB_CAPACITY_PLAN_BIN)
	./$(BLOB_EFFECT_BUDGET_BIN)
	./$(BLOB_DETECTION_PROFILE_BIN)
	./$(TEMPORAL_SEMANTIC_BIN)
	./$(BLUEPRINT_SEMANTIC_BIN)
	./$(FRAGMENT_SEMANTIC_BIN)
	./$(QUADRANT_SEMANTIC_BIN)
	./$(SCENE_SWITCH_BIN)
	./$(SKIN_LOADER_BIN)
	./$(FOCUS_BIN)
	./$(WALL_CLOCK_BIN)
	./$(SYSTEM_VITALS_BIN)
	./$(INSTALLATION_BIN)
	./$(SETTINGS_PAGE_BIN)
	./$(PRESENTATION_BIN)
	./$(SCHEDULE_BIN)

blueprint-semantic: $(BLUEPRINT_SEMANTIC_BIN)
	./$(BLUEPRINT_SEMANTIC_BIN)

$(BLUEPRINT_SEMANTIC_BIN): $(BLUEPRINT_SEMANTIC_SRC) ../src/BlueprintSemanticMapping.h
	$(CXX) $(BLUEPRINT_SEMANTIC_CXXFLAGS) $(BLUEPRINT_SEMANTIC_SRC) -o $(BLUEPRINT_SEMANTIC_BIN)

fragment-semantic: $(FRAGMENT_SEMANTIC_BIN)
	./$(FRAGMENT_SEMANTIC_BIN)

$(FRAGMENT_SEMANTIC_BIN): $(FRAGMENT_SEMANTIC_SRC) ../src/FragmentSemanticMapping.h
	$(CXX) $(FRAGMENT_SEMANTIC_CXXFLAGS) $(FRAGMENT_SEMANTIC_SRC) -o $(FRAGMENT_SEMANTIC_BIN)

quadrant-semantic: $(QUADRANT_SEMANTIC_BIN)
	./$(QUADRANT_SEMANTIC_BIN)

$(QUADRANT_SEMANTIC_BIN): $(QUADRANT_SEMANTIC_SRC) ../src/QuadrantSemanticMapping.h
	$(CXX) $(QUADRANT_SEMANTIC_CXXFLAGS) $(QUADRANT_SEMANTIC_SRC) -o $(QUADRANT_SEMANTIC_BIN)

skin: $(SKIN_LOADER_BIN)
	./$(SKIN_LOADER_BIN)

$(SKIN_LOADER_BIN): $(SKIN_LOADER_SRC) ../src/HudSkinLoader.h ../src/HudSkinPng.h ../../../shared/src/hud-compositor/HudReactiveControlArt.h ../../../tools/hud-skin-manifest/HudSkinManifest.h
	$(CXX) $(SKIN_LOADER_CXXFLAGS) $(SKIN_LOADER_SRC) -o $(SKIN_LOADER_BIN)

session2: $(SESSION2_BIN)
	./$(SESSION2_BIN)

$(LIFECYCLE_BIN): $(LIFECYCLE_SRC) ../src/FakeSceneLifecycleState.h
	$(CXX) $(CXXFLAGS) $(LIFECYCLE_SRC) -o $(LIFECYCLE_BIN)

$(SESSION2_BIN): $(SESSION2_SRC)
	$(CXX) $(SESSION2_CXXFLAGS) $(SESSION2_SRC) -o $(SESSION2_BIN)

$(BLOB_SEMANTIC_BIN): $(BLOB_SEMANTIC_SRC) ../src/BlobSemanticMapping.h
	$(CXX) $(BLOB_SEMANTIC_CXXFLAGS) $(BLOB_SEMANTIC_SRC) -o $(BLOB_SEMANTIC_BIN)

$(BLOB_EFFECT_POLICY_BIN): $(BLOB_EFFECT_POLICY_SRC) ../src/BlobEffectPolicy.h
	$(CXX) $(CXXFLAGS) $(BLOB_EFFECT_POLICY_SRC) -o $(BLOB_EFFECT_POLICY_BIN)

$(BLOB_CAPACITY_PLAN_BIN): $(BLOB_CAPACITY_PLAN_SRC) ../src/BlobCapacityPlan.h
	$(CXX) $(CXXFLAGS) $(BLOB_CAPACITY_PLAN_SRC) -o $(BLOB_CAPACITY_PLAN_BIN)

$(BLOB_EFFECT_BUDGET_BIN): $(BLOB_EFFECT_BUDGET_SRC) ../src/BlobEffectBudget.h
	$(CXX) $(CXXFLAGS) $(BLOB_EFFECT_BUDGET_SRC) -o $(BLOB_EFFECT_BUDGET_BIN)

$(BLOB_DETECTION_PROFILE_BIN): $(BLOB_DETECTION_PROFILE_SRC) ../../../shared/src/BlobDetectionProfileStore.h
	$(CXX) $(BLOB_DETECTION_PROFILE_CXXFLAGS) $(BLOB_DETECTION_PROFILE_SRC) -o $(BLOB_DETECTION_PROFILE_BIN)

$(TEMPORAL_SEMANTIC_BIN): $(TEMPORAL_SEMANTIC_SRC) ../src/TemporalSemanticMapping.h
	$(CXX) $(TEMPORAL_SEMANTIC_CXXFLAGS) $(TEMPORAL_SEMANTIC_SRC) -o $(TEMPORAL_SEMANTIC_BIN)

$(SCENE_SWITCH_BIN): $(SCENE_SWITCH_SRC) ../src/SceneSwitchController.h
	$(CXX) $(CXXFLAGS) $(SCENE_SWITCH_SRC) -o $(SCENE_SWITCH_BIN)

clean:
	rm -f $(SETTINGS_PAGE_BIN) $(LIFECYCLE_BIN) $(SESSION2_BIN) $(BLOB_SEMANTIC_BIN) $(BLOB_EFFECT_POLICY_BIN) $(BLOB_CAPACITY_PLAN_BIN) $(BLOB_EFFECT_BUDGET_BIN) $(BLOB_DETECTION_PROFILE_BIN) $(TEMPORAL_SEMANTIC_BIN) $(BLUEPRINT_SEMANTIC_BIN) $(FRAGMENT_SEMANTIC_BIN) $(QUADRANT_SEMANTIC_BIN) $(SCENE_SWITCH_BIN) $(SKIN_LOADER_BIN) $(FOCUS_BIN) $(WALL_CLOCK_BIN) $(SYSTEM_VITALS_BIN) $(INSTALLATION_BIN) $(PRESENTATION_BIN) $(SCHEDULE_BIN)
